<?xml version="1.0" encoding="UTF-8"?>
<!-- Own descriptor; refers to the unmodified font supplied by OpenMW. -->
<MyGUI type="Resource" version="1.1">
    <Resource type="ResourceTrueTypeFont">
        <Property key="Source" value="DejaVuLGCSansMono.ttf"/>
        <Property key="Antialias" value="true"/>
        <Property key="TabWidth" value="4"/>
        <Property key="OffsetHeight" value="0"/>
        <Property key="Resolution" value="96"/>
        <Codes>
            <Code range="33 126"/>
            <Code range="160 382"/>
            <Code range="1025 1105"/>
            <Code range="8208 8230"/>
            <Code range="8592 8601"/>
            <Code range="8470"/>
        </Codes>
    </Resource>
</MyGUI>
